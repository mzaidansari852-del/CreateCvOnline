# ---------------------------------------------------------------------------
# CreateCVOnline — environment variables
#
# Copy this file to `.env.local` for local development and set the same values
# in your hosting provider's dashboard for production.
#
#   cp .env.example .env.local
#
# Variables prefixed with NEXT_PUBLIC_ are inlined into the client bundle and are
# therefore PUBLIC. Everything else is server-only and must never be exposed.
# ---------------------------------------------------------------------------


# ===========================================================================
# 1. APPLICATION
# ===========================================================================

# Canonical, absolute, no trailing slash. Used for SEO metadata, sitemap,
# canonical URLs, Open Graph images, share links and Polar's return URLs.
# Production value:  https://createcvonline.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown in the UI, metadata and structured data.
NEXT_PUBLIC_SITE_NAME=CreateCVOnline


# ===========================================================================
# 2. FIREBASE — CLIENT (public web app config)
#    Firebase Console -> Project settings -> General -> Your apps -> Web app
#    These values are public by design; access is controlled by Security Rules.
# ===========================================================================

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional — enables Firebase Analytics in the browser when present.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=


# ===========================================================================
# 3. FIREBASE — ADMIN (server only, NEVER prefix with NEXT_PUBLIC_)
#    Firebase Console -> Project settings -> Service accounts
#    -> "Generate new private key"
#
#    Provide EITHER the three discrete values below, OR a single
#    FIREBASE_SERVICE_ACCOUNT_JSON containing the whole downloaded JSON file.
# ===========================================================================

FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the literal \n escapes, wrapped in double quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# Alternative to the three variables above (useful on hosts that dislike multiline secrets):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Optional — only needed if you use Storage from the server.
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app


# ===========================================================================
# 4. PAYMENTS  (nothing is sold without one of these two configured)
#
#    Two gateways can be live at once. Configure either, or both:
#
#      POLAR   — the intended long-term gateway. Merchant of record: it sells to
#                the customer, charges the card and owes the EU VAT. That is why it
#                replaced Paddle rather than Stripe — this site sells to Germany,
#                France and the Netherlands, and going direct would mean registering
#                for VAT OSS and filing it ourselves.
#
#      PAYPAL  — the interim gateway, here because Polar's account is not live yet
#                and Paddle's was declined. PayPal is a plain processor, NOT a
#                merchant of record, so while it is taking payments WE are the
#                seller of record and the EU VAT is ours to account for. Nothing in
#                the code tracks that. Turn it off once Polar is live.
#
#    When both are set the checkout shows a picker and defaults to Polar.
# ===========================================================================


# ---------------------------------------------------------------------------
# 4a. POLAR
#     Dashboard:        https://polar.sh/dashboard
#     Sandbox:          https://sandbox.polar.sh
#     Full walkthrough: docs/POLAR_SETUP.md
# ---------------------------------------------------------------------------

# "sandbox" while testing, "production" in production.
#
# Read this one carefully, because Polar gives you less protection here than Paddle did.
# A Paddle key announced its own environment in its prefix, so a half-finished go-live
# was caught by comparing the two. Polar's tokens use the SAME prefix in both
# environments, so nothing can detect a sandbox token deployed to production except
# this variable. Anything other than the exact word "production" is treated as sandbox.
#
# `lib/env.ts` refuses to build when this says "sandbox" on a Vercel production
# deployment, because a sandbox payment still satisfies every check that grants a plan:
# anyone could pay with a test card and be granted Pro for free.
POLAR_ENVIRONMENT=sandbox

# Server-side access token. Polar > Settings > Developers > New token.
# SECRET. Prefer an ORGANIZATION token (polar_oat_…) over a personal one (polar_pat_…):
# a personal token is tied to one human and dies when they rotate it or leave, taking
# checkout with it. Never put this in a NEXT_PUBLIC_ variable.
POLAR_ACCESS_TOKEN=

# The product id for each paid plan. Polar > Products > (product) > copy the ID.
# UUIDs, not secrets — the customer sees them — but sandbox and production ids differ,
# so they live here rather than in lib/plans.ts. The gateway is only enabled when the
# access token AND both of these are set and well-formed; a half-configured Polar
# offers no checkout at all, which is honest, rather than a button that fails on the
# customer's card.
# Example shape: 9d1b4a7e-3c2f-4e51-8a06-7b2c9f4e1d33
POLAR_PRODUCT_PRO=
POLAR_PRODUCT_LIFETIME=

# Set after creating the webhook endpoint (Polar > Settings > Webhooks).
# The endpoint's own signing secret, starting whsec_. SECRET.
# Without it the webhook endpoint rejects EVERY event with 403 — checkout still works,
# but nothing is ever fulfilled by the authoritative path.
#
# Endpoint URL:  https://<your-domain>/api/payments/polar/webhook
# Events to subscribe to:  order.paid  and  order.refunded
#
# NOTE on signing: Polar changed webhook signing to Standard Webhooks on 8 Sept 2026.
# Secrets generated before that date use the older Polar HMAC scheme. The pinned SDK
# (@polar-sh/sdk 1.0.0-alpha.20) accepts both. Do NOT "upgrade" to the 0.49.x release
# that npm tags `latest` — it only implements the OLD scheme, so a secret generated
# after the cutover fails every signature check and silently stops all fulfilment.
POLAR_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# 4b. PAYPAL  (interim — remove once Polar is live)
#     Dashboard:        https://developer.paypal.com/dashboard/applications
#     Full walkthrough: docs/PAYPAL_SETUP.md
# ---------------------------------------------------------------------------

# "sandbox" while testing, "live" in production. PayPal's own words, so that they
# match the toggle in the developer dashboard you are copying credentials from.
# Anything other than the exact word "live" is treated as sandbox.
#
# The same trap as POLAR_ENVIRONMENT, and just as unprotected: a PayPal client id
# announces nothing about its environment, so this variable is the only thing that
# decides which API is called.
#
# IMPORTANT: on a Vercel *production* deployment, sandbox disables the gateway.
# `lib/env.ts` treats sandbox-credentials-on-production as an absent gateway, so the
# checkout says payments are unavailable — a sandbox order still captures as
# COMPLETED for the plan price, and anyone could pay with a PayPal test account and
# be granted Pro for free. Sandbox testing belongs on a PREVIEW deployment, where
# this restriction does not apply. Production takes live credentials only.
#
# Leaving this unset counts as sandbox.
PAYPAL_ENVIRONMENT=sandbox

# REST API app credentials. PayPal Developer Dashboard > Apps & Credentials >
# (Sandbox | Live) > your app. The client id is not secret; the secret is.
# Both are ~80 characters. If either looks short it was truncated on paste —
# `lib/payments/paypal.ts` reports the lengths in its 401 message for exactly that
# reason. The gateway is enabled as soon as both are set.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Set after creating the webhook in the same app (Webhooks > Add webhook).
# Without it the webhook route rejects EVERY event, because an event whose
# signature cannot be verified must never be allowed to grant paid access.
# Checkout still works without it — the browser capture path grants the plan — but
# the safety net for a closed tab, a delayed settlement or a later refund is gone.
#
# Endpoint URL:  https://<your-domain>/api/payments/paypal/webhook
# Events to subscribe to:
#   CHECKOUT.ORDER.APPROVED     PAYMENT.CAPTURE.COMPLETED
#   PAYMENT.CAPTURE.DENIED      PAYMENT.CAPTURE.REFUNDED
#   PAYMENT.CAPTURE.REVERSED    CHECKOUT.ORDER.VOIDED
PAYPAL_WEBHOOK_ID=


# ---------------------------------------------------------------------------
# 4c. Shared by both gateways
# ---------------------------------------------------------------------------

# Three-letter ISO code the prices in lib/plans.ts are quoted in. Falls back to
# the retired NEXT_PUBLIC_PAYPAL_CURRENCY, then USD, so deployments that set the
# old variable need no new entry.
#
# PayPal charges exactly this currency and rejects an order in one it does not
# support for the account, so it has to be a currency your PayPal business account
# can receive.
NEXT_PUBLIC_STORE_CURRENCY=USD

# ---------------------------------------------------------------------------
# Paddle (retired — the seller account was declined during review)
# ---------------------------------------------------------------------------
# Nothing is sold through Paddle any more and `gateway()` will not select it. The
# server-side integration is kept only so that any sandbox rows written during the
# aborted integration remain reconcilable in the admin console. Leave these unset
# unless you are looking at one of those rows.
#
# PADDLE_ENVIRONMENT=sandbox
# PADDLE_API_KEY=
# PADDLE_PRICE_PRO=
# PADDLE_PRICE_LIFETIME=
# PADDLE_WEBHOOK_SECRET=


# ===========================================================================
# 5. EMAIL  (announcements from /admin/email — optional)
#     Full walkthrough: docs/EMAIL_SETUP.md
#
#     Sends through an ordinary mailbox over SMTP, not a bulk provider. That is
#     fine for the low hundreds and wrong for tens of thousands — exceeding a
#     mailbox's hourly cap gets the domain treated as a spam source, which costs
#     password resets and payment receipts, not just marketing.
# ===========================================================================

# Hostinger: smtp.hostinger.com. Gmail/Workspace: smtp.gmail.com.
SMTP_HOST=smtp.hostinger.com

# 465 for implicit TLS, 587 for STARTTLS. Whether the connection is encrypted
# from the first byte is derived from this, so it must match what the server
# expects — the wrong one produces a connection that hangs rather than fails.
SMTP_PORT=465

# The FULL mailbox address, not the local part. SECRET password.
SMTP_USER=contact@createcvonline.com
SMTP_PASSWORD=

# Optional. The From: address and display name.
# Most providers, Hostinger included, refuse to send with a From: that is not the
# authenticated mailbox — so leave SMTP_FROM unset unless you know yours allows it.
# SMTP_FROM=contact@createcvonline.com
# SMTP_FROM_NAME=CreateCVOnline
# SMTP_REPLY_TO=support@createcvonline.com

# Optional override for the TLS mode, for a server that does something unusual.
# SMTP_SECURE=true


# ===========================================================================
# 6. ANALYTICS (all optional)
# ===========================================================================

# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML tag verification token (the `content` value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=


# ===========================================================================
# 7. PDF EXPORT
# ===========================================================================

# Where the PDF renderer finds a Chromium binary.
#   - Leave empty on Vercel / AWS Lambda: @sparticuz/chromium is used automatically.
#   - Set an absolute path when self-hosting or in Docker, e.g.
#     /usr/bin/chromium or /usr/bin/google-chrome-stable
PDF_CHROMIUM_EXECUTABLE_PATH=

# Optional — a remote Chrome DevTools Protocol endpoint (Browserless, Chrome
# running in a sidecar container, ...). Takes precedence over the two options above.
# PDF_BROWSER_WS_ENDPOINT=wss://chrome.browserless.io?token=...

# Shared secret used to sign short-lived, single-purpose render tokens so that the
# internal /print route cannot be scraped. Generate with:  openssl rand -hex 32
PDF_RENDER_SECRET=change-me-to-a-long-random-string


# ===========================================================================
# 8. SECURITY
# ===========================================================================

# Lifetime of the httpOnly session cookie, in days (max 14 — Firebase limit).
SESSION_COOKIE_DAYS=5

# Comma-separated list of e-mail addresses that are bootstrapped as administrators
# by `npm run set-admin`. Admin access itself is enforced through Firebase custom claims.
ADMIN_EMAILS=

# Requests per window for the built-in API rate limiter.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# CV import — AI reading (optional)
# ---------------------------------------------------------------------------
# Absent, the importer uses its rules-based reader for everyone. Present, Pro
# and Lifetime accounts get the model reader instead, with the rules as the
# fallback whenever the key, the network or the reply fails.
#
# MUST be a PAID Google AI Studio key. The free tier trains on submitted data,
# and what is submitted here is somebody's CV — name, address, employers. For
# EU applicants that is a GDPR problem, not a preference.
#
# Cost is roughly $0.0009 per CV on gemini-2.5-flash-lite, so about a thousand
# imports per dollar.
GEMINI_API_KEY=
# Optional override. Leave blank and the importer tries a list of models in
# order, cheapest first, moving on when one answers 404 — which Google returns
# both for a deprecated name and for a model this project is not entitled to.
# Set it only to pin a specific model; a wrong value here costs one wasted
# request per import before the fallbacks take over.
#
# Flash-lite is the default because extraction is a copying task: paying for
# reasoning buys latency the user waits through, not accuracy.
GEMINI_MODEL=
