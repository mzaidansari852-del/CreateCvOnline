# ---------------------------------------------------------------------------
# CreateCVOnline — environment variables
#
# Copy this file to `.env.local` for local development and set the same values
# in your hosting provider's dashboard for production.
#
#   cp .env.example .env.local
#
# Variables prefixed with NEXT_PUBLIC_ are inlined into the client bundle and are
# therefore PUBLIC. Everything else is server-only and must never be exposed.
# ---------------------------------------------------------------------------


# ===========================================================================
# 1. APPLICATION
# ===========================================================================

# Canonical, absolute, no trailing slash. Used for SEO metadata, sitemap,
# canonical URLs, Open Graph images, share links and PayPal return URLs.
# Production value:  https://createcvonline.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown in the UI, metadata and structured data.
NEXT_PUBLIC_SITE_NAME=CreateCVOnline


# ===========================================================================
# 2. FIREBASE — CLIENT (public web app config)
#    Firebase Console -> Project settings -> General -> Your apps -> Web app
#    These values are public by design; access is controlled by Security Rules.
# ===========================================================================

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional — enables Firebase Analytics in the browser when present.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=


# ===========================================================================
# 3. FIREBASE — ADMIN (server only, NEVER prefix with NEXT_PUBLIC_)
#    Firebase Console -> Project settings -> Service accounts
#    -> "Generate new private key"
#
#    Provide EITHER the three discrete values below, OR a single
#    FIREBASE_SERVICE_ACCOUNT_JSON containing the whole downloaded JSON file.
# ===========================================================================

FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the literal \n escapes, wrapped in double quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# Alternative to the three variables above (useful on hosts that dislike multiline secrets):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Optional — only needed if you use Storage from the server.
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app


# ===========================================================================
# 4. PAYPAL
#    https://developer.paypal.com/dashboard/applications
# ===========================================================================

# "sandbox" while testing, "live" in production.
PAYPAL_ENVIRONMENT=sandbox

# Server-side credentials (REST API app).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# The same client id, exposed to the browser so the PayPal Buttons SDK can load.
# It must match PAYPAL_CLIENT_ID.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Three-letter ISO currency code used for PayPal orders. Superseded by
# NEXT_PUBLIC_STORE_CURRENCY (section 5) as "what our prices mean"; kept as its
# fallback so existing deployments need no new entry.
NEXT_PUBLIC_PAYPAL_CURRENCY=USD

# Optional — set after creating a webhook in the PayPal dashboard. When present,
# incoming webhooks are cryptographically verified against PayPal's API.
PAYPAL_WEBHOOK_ID=


# ===========================================================================
# 5. PADDLE  (merchant of record — preferred over PayPal when configured)
#    Sandbox dashboard: https://sandbox-vendors.paddle.com
#    Full walkthrough:  docs/PADDLE_SETUP.md
# ===========================================================================

# "sandbox" while testing, "production" in production.
# NOT "live" — PayPal spells it that way, Paddle does not, and anything other
# than the exact word "production" is treated as sandbox.
PADDLE_ENVIRONMENT=sandbox

# Server-side API key. Paddle > Developer tools > Authentication > API keys.
# SECRET. Sandbox keys start pdl_sdbx_apikey_, live keys pdl_live_apikey_.
# Never put this in a NEXT_PUBLIC_ variable — that would publish it to every visitor.
PADDLE_API_KEY=

# The price id for each paid plan. Paddle > Catalog > Products > (product) > Prices.
# Not secrets — they appear in the checkout — but sandbox and production ids differ,
# so they live here rather than in lib/plans.ts. The gateway is only enabled when the
# API key AND both of these are set; a half-configured Paddle falls back to PayPal.
# The prices in Paddle must match lib/plans.ts exactly, or payments are refused.
# Example shape: pri_01hv8x9k2m3n4p5q6r7s8t9u0v
PADDLE_PRICE_PRO=
PADDLE_PRICE_LIFETIME=

# Set after creating the webhook (Paddle > Developer tools > Notifications).
# The destination's own secret key, starting pdl_ntfset_. SECRET.
# Without it the webhook endpoint rejects EVERY event with 401.
PADDLE_WEBHOOK_SECRET=

# The client-side token, exposed to the browser so Paddle.js can open the overlay.
# PUBLIC by design and NOT the API key: sandbox tokens start test_, live ones live_.
# If the value here starts pdl_, you have pasted the API key — rotate it immediately.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Which Paddle.js the browser loads. Must agree with PADDLE_ENVIRONMENT above.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

# Three-letter ISO code the prices in lib/plans.ts are quoted in. Read by both
# gateways. Falls back to NEXT_PUBLIC_PAYPAL_CURRENCY, then USD, so existing
# deployments need no new entry.
NEXT_PUBLIC_STORE_CURRENCY=USD


# ===========================================================================
# 6. ANALYTICS (all optional)
# ===========================================================================

# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML tag verification token (the `content` value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=


# ===========================================================================
# 7. PDF EXPORT
# ===========================================================================

# Where the PDF renderer finds a Chromium binary.
#   - Leave empty on Vercel / AWS Lambda: @sparticuz/chromium is used automatically.
#   - Set an absolute path when self-hosting or in Docker, e.g.
#     /usr/bin/chromium or /usr/bin/google-chrome-stable
PDF_CHROMIUM_EXECUTABLE_PATH=

# Optional — a remote Chrome DevTools Protocol endpoint (Browserless, Chrome
# running in a sidecar container, ...). Takes precedence over the two options above.
# PDF_BROWSER_WS_ENDPOINT=wss://chrome.browserless.io?token=...

# Shared secret used to sign short-lived, single-purpose render tokens so that the
# internal /print route cannot be scraped. Generate with:  openssl rand -hex 32
PDF_RENDER_SECRET=change-me-to-a-long-random-string


# ===========================================================================
# 8. SECURITY
# ===========================================================================

# Lifetime of the httpOnly session cookie, in days (max 14 — Firebase limit).
SESSION_COOKIE_DAYS=5

# Comma-separated list of e-mail addresses that are bootstrapped as administrators
# by `npm run set-admin`. Admin access itself is enforced through Firebase custom claims.
ADMIN_EMAILS=

# Requests per window for the built-in API rate limiter.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60
